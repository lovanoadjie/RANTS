<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Utama -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/img_1"
        android:gravity="center"
        android:padding="16dp" />

    <!-- Gambar Utama -->
    <ImageView
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="90dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ganbar2" />

    <!-- Elemen yang akan dianimasikan -->
    <LinearLayout
        android:id="@+id/keatas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:translationY="800dp"
        android:alpha="0"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="0dp">

        <!-- TextView putih sebagai background bawah -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:background="@drawable/rounded_top_corners"
            android:padding="16dp">

            <!-- Konten di dalam background putih -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Tulisan Selamat Datang -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Selamat Datang Di Aplikasi RANTS"
                    android:textSize="30sp"
                    android:textStyle="bold|italic"
                    android:textColor="#033C10"
                    android:fontFamily="@font/poppins"
                    android:lineSpacingExtra="4dp" />

                <!-- Tombol Masuk -->
                <Button
                    android:id="@+id/startButton"
                    android:layout_width="100dp"
                    android:layout_height="45dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/backgroundbutton"
                    android:padding="10dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Masuk"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
