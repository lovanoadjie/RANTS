<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:gravity="center"
            android:padding="16dp" />

        <ImageView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ganbar2" />


        <!-- CardView untuk form login -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginBottom="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="15dp"
                            android:text="Registrasi"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:background="@android:color/transparent"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="10dp"
                            android:layout_marginHorizontal="15dp"
                            android:layout_marginVertical="10dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:background="@color/white"
                                    android:paddingStart="8dp">

                                        <!-- Ikon Person -->
                                        <ImageView
                                            android:id="@+id/usn"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:src="@drawable/baseline_person_24"
                                            app:tint="@color/grey"
                                            android:layout_gravity="center_vertical" />

                                        <!-- EditText -->
                                        <EditText
                                            android:id="@+id/editText1"
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:hint="Nama Lengkap"
                                            android:fontFamily="@font/poppins_light"
                                            android:inputType="text"
                                            android:paddingStart="8dp"
                                            android:textSize="16sp"
                                            android:textColor="@color/black"
                                            android:textColorHint="@color/grey"
                                            android:background="@android:color/transparent" />
                                </LinearLayout>

                        </androidx.cardview.widget.CardView>


                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:background="@android:color/transparent"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="10dp"
                            android:layout_marginHorizontal="15dp"
                            android:layout_marginVertical="10dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:background="@color/white"
                                    android:paddingStart="8dp">

                                        <!-- Ikon Person -->
                                        <ImageView
                                            android:id="@+id/hp"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:src="@drawable/baseline_call_24"
                                            app:tint="@color/grey"
                                            android:layout_gravity="center_vertical" />

                                        <!-- EditText -->
                                        <EditText
                                            android:id="@+id/editTextNoHP"
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:hint="Nomor HP"
                                            android:fontFamily="@font/poppins_light"
                                            android:inputType="text"
                                            android:paddingStart="8dp"
                                            android:textSize="16sp"
                                            android:textColor="@color/black"
                                            android:textColorHint="@color/grey"
                                            android:background="@android:color/transparent" />
                                </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:background="@android:color/transparent"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="10dp"
                            android:layout_margin="15dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:background="@color/white"
                                    android:paddingStart="8dp">

                                        <!-- Ikon Email -->
                                        <ImageView
                                            android:id="@+id/emailIcon"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:src="@drawable/baseline_email_24"
                                            app:tint="@color/grey"
                                            android:layout_gravity="center_vertical" />

                                        <!-- EditText -->
                                        <EditText
                                            android:id="@+id/editText2"
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:background="@android:color/transparent"
                                            android:fontFamily="@font/poppins_light"
                                            android:hint="Email"
                                            android:paddingStart="8dp"
                                            android:textColor="@color/black"
                                            android:textColorHint="@color/grey"
                                            android:textSize="16sp"
                                            android:inputType="text" />
                                </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:background="@android:color/transparent"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="10dp"
                            android:layout_marginHorizontal="15dp"
                            android:layout_marginVertical="10dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:background="@color/white"
                                    android:paddingStart="8dp">

                                        <!-- Ikon Password -->
                                        <ImageView
                                            android:id="@+id/passwordIcon"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:src="@drawable/baseline_lock_24"
                                            app:tint="@color/grey"
                                            android:layout_gravity="center_vertical" />

                                        <!-- EditText -->
                                        <EditText
                                            android:id="@+id/editText3"
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:background="@android:color/transparent"
                                            android:hint="Password"
                                            android:fontFamily="@font/poppins_light"
                                            android:paddingStart="8dp"
                                            android:textColor="@color/black"
                                            android:textColorHint="@color/grey"
                                            android:textSize="16sp"
                                            android:inputType="textPassword" />
                                </LinearLayout>

                        </androidx.cardview.widget.CardView>


                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom"
                            android:background="@android:color/transparent"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="10dp"
                            android:layout_marginHorizontal="15dp"
                            android:layout_marginVertical="10dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:background="@color/white"
                                    android:paddingStart="8dp">

                                        <!-- Ikon Password -->
                                        <ImageView
                                            android:id="@+id/password"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:src="@drawable/baseline_lock_24"
                                            app:tint="@color/grey"
                                            android:layout_gravity="center_vertical" />

                                        <!-- EditText -->
                                        <EditText
                                            android:id="@+id/editText4"
                                            android:layout_width="0dp"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:background="@android:color/transparent"
                                            android:hint="Konfirmasi Password"
                                            android:fontFamily="@font/poppins_light"
                                            android:paddingStart="8dp"
                                            android:textColor="@color/black"
                                            android:textColorHint="@color/grey"
                                            android:textSize="16sp"
                                            android:inputType="textPassword" />
                                </LinearLayout>

                        </androidx.cardview.widget.CardView>




                        <Button
                            android:id="@+id/setdaftarButton"
                            android:layout_width="150dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/rounded_register"
                            android:fontFamily="@font/poppins"
                            android:padding="5dp"
                            android:text="Daftar"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                        <!-- Bagian teks "Belum Punya Akun?" dan tombol "Daftar" -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="20dp"
                            android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppins_regular"
                                    android:text="Sudah  Punya Akun?"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/loginButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp" android:fontFamily="@font/poppins_semibold"
                                    android:onClick="onLoginClick"
                                    android:text="Login Sekarang"
                                    android:textColor="#CE0000"
                                    android:textSize="14sp"
                                    app:backgroundTint="@null" />
                        </LinearLayout>

                </LinearLayout>
        </androidx.cardview.widget.CardView>

</FrameLayout>